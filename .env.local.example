# Supabase Project Settings → API → Project URL. Safe to expose to the
# client (NEXT_PUBLIC_ prefix) — used to initialize the Supabase client
# in the browser and on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Project Settings → API → anon/public key. Safe to expose to the
# client — access is enforced by row-level security (RLS), not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# Used by /api/create to classify and log free-text entries.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# Supabase Project Settings → API → service_role key. Used by /api/signup to
# auto-confirm new users' emails so they can sign in immediately. Remove
# this auto-confirm step (and this key) before shipping to real users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# resend.com → API Keys. Used by /api/signup to send the welcome email, and
# by /api/weekly-digest (not yet scheduled) to send the weekly summary.
RESEND_API_KEY=your-resend-api-key

# Optional. The "from" address used for outgoing emails, e.g.
# "Ionexa AI <hello@yourdomain.com>" once you've verified a sending domain in
# Resend. Falls back to Resend's shared sandbox address (onboarding@resend.dev)
# if unset, which only delivers to the email on your own Resend account.
RESEND_FROM_EMAIL="Ionexa AI <onboarding@resend.dev>"

# Optional. Your production URL, no trailing slash (e.g. https://ai-os.app).
# Used by robots.txt and sitemap.xml to build absolute URLs. Falls back to
# http://localhost:3000 if unset — fine for local dev, but set this before
# deploying so search engines get correct sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Server-side only — never expose to the client. Comma-separated
# list of emails that always get full Enterprise-tier access (unlimited
# credits, team seats) without a real Stripe subscription — see
# src/lib/admin.ts, which also hardcodes eliasgiannakos51@gmail.com as a
# founder account regardless of this var.
ADMIN_EMAILS=owner@example.com,cofounder@example.com

# Server-side only — never expose to the client. Stripe Secret Key (test or
# live) and the signing secret for the /api/webhooks/stripe endpoint. See
# the README's Billing section for full setup steps.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Server-side only. Stripe recurring Price IDs (EUR), one per self-serve
# paid plan (see src/lib/billing/plans.ts) — Enterprise has no entry, it's
# Contact Sales only. STRIPE_PRICE_TEAM_SEAT is the shared per-seat add-on
# price used by Professional, Ultimate, and Enterprise.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ULTIMATE=price_...
STRIPE_PRICE_TEAM_SEAT=price_...

# Server-side only. Stripe one-time (not recurring) Price IDs (EUR) for the
# credit packs sold from Settings → Buy Credits (src/lib/billing/plans.ts's
# CREDIT_PACKS: €10=500, €25=1500, €50=3500, €100=8000 credits).
STRIPE_PRICE_CREDITS_10=price_...
STRIPE_PRICE_CREDITS_25=price_...
STRIPE_PRICE_CREDITS_50=price_...
STRIPE_PRICE_CREDITS_100=price_...

# Optional. Server-side only. Shared secret checked against the
# `Authorization: Bearer <CRON_SECRET>` header on /api/weekly-digest and
# /api/cron/reset-credits — set this before pointing a real scheduler
# (Vercel Cron, a GitHub Action, etc.) at either route.
CRON_SECRET=your-cron-secret
