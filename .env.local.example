# Supabase Project Settings → API → Project URL. Safe to expose to the
# client (NEXT_PUBLIC_ prefix) — used to initialize the Supabase client
# in the browser and on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Project Settings → API → anon/public key. Safe to expose to the
# client — access is enforced by row-level security (RLS), not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# Used by /api/create to classify and log free-text entries.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# Supabase Project Settings → API → service_role key. Used by /api/signup to
# auto-confirm new users' emails so they can sign in immediately. Remove
# this auto-confirm step (and this key) before shipping to real users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# resend.com → API Keys. Used by /api/signup to send the welcome email, and
# by /api/weekly-digest (not yet scheduled) to send the weekly summary.
RESEND_API_KEY=your-resend-api-key

# Optional. The "from" address used for outgoing emails, e.g.
# "AI_OS <hello@yourdomain.com>" once you've verified a sending domain in
# Resend. Falls back to Resend's shared sandbox address (onboarding@resend.dev)
# if unset, which only delivers to the email on your own Resend account.
RESEND_FROM_EMAIL="AI_OS <onboarding@resend.dev>"

# Optional. Your production URL, no trailing slash (e.g. https://ai-os.app).
# Used by robots.txt and sitemap.xml to build absolute URLs. Falls back to
# http://localhost:3000 if unset — fine for local dev, but set this before
# deploying so search engines get correct sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
