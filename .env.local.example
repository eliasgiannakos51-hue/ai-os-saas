# Supabase Project Settings → API → Project URL. Safe to expose to the
# client (NEXT_PUBLIC_ prefix) — used to initialize the Supabase client
# in the browser and on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Project Settings → API → anon/public key. Safe to expose to the
# client — access is enforced by row-level security (RLS), not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# Used by /api/create to classify and log free-text entries.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# Supabase Project Settings → API → service_role key. Used by /api/signup to
# auto-confirm new users' emails so they can sign in immediately. Remove
# this auto-confirm step (and this key) before shipping to real users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only — never expose to the client (no NEXT_PUBLIC_ prefix).
# resend.com → API Keys. Used by /api/signup to send the welcome email, and
# by /api/weekly-digest (not yet scheduled) to send the weekly summary.
RESEND_API_KEY=your-resend-api-key

# Optional. The "from" address used for outgoing emails, e.g.
# "Ionexa AI <hello@yourdomain.com>" once you've verified a sending domain in
# Resend. Falls back to Resend's shared sandbox address (onboarding@resend.dev)
# if unset, which only delivers to the email on your own Resend account.
RESEND_FROM_EMAIL="Ionexa AI <onboarding@resend.dev>"

# Optional. Your production URL, no trailing slash (e.g. https://ionexa.ai).
# Used for every outbound link the app generates back to itself: Stripe
# Checkout success/cancel URLs, the billing portal return URL, email
# confirmation/reset links, robots.txt/sitemap.xml, and OG image URLs. On
# Vercel, unset falls back to the deployment's own VERCEL_URL /
# VERCEL_PROJECT_PRODUCTION_URL (see lib/site-url.ts) rather than
# localhost, so this is only required if you're on a custom domain and
# want links to use that instead of the assigned *.vercel.app one. Falls
# back further to http://localhost:3000 outside Vercel (local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Server-side only — never expose to the client. Comma-separated
# list of emails that always get full Enterprise-tier access (unlimited
# credits, team seats) without a real Stripe subscription — see
# src/lib/admin.ts, which also hardcodes eliasgiannakos51@gmail.com as a
# founder account regardless of this var.
ADMIN_EMAILS=owner@example.com,cofounder@example.com

# Server-side only — never expose to the client. Stripe Secret Key (test or
# live) and the signing secret for the /api/webhooks/stripe endpoint. See
# the README's Billing section for full setup steps.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Server-side only. Stripe recurring Price IDs (EUR), one per self-serve
# paid plan (see src/lib/billing/plans.ts) — Enterprise has no entry, it's
# Contact Sales only. STRIPE_PRICE_TEAM_SEAT is the shared per-seat add-on
# price used by Professional, Ultimate, and Enterprise.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ULTIMATE=price_...
STRIPE_PRICE_TEAM_SEAT=price_...

# Server-side only. Stripe one-time (not recurring) Price IDs (EUR) for the
# credit packs sold from Settings → Buy Credits (src/lib/billing/plans.ts's
# CREDIT_PACKS: €10=500, €25=1500, €50=3500, €100=8000 credits).
STRIPE_PRICE_CREDITS_10=price_...
STRIPE_PRICE_CREDITS_25=price_...
STRIPE_PRICE_CREDITS_50=price_...
STRIPE_PRICE_CREDITS_100=price_...

# Optional in local development, REQUIRED on every deployment. Server-side
# only. Shared secret checked against the `Authorization: Bearer
# <CRON_SECRET>` header (or `x-cron-secret`) on /api/weekly-digest,
# /api/cron/reset-credits, /api/cron/scheduled-runs and
# /api/cron/agent-runs.
#
# The guard fails CLOSED (src/lib/cron-auth.ts): with no secret set, those
# routes refuse to run at all on a deployment. That matters most for
# /api/cron/agent-runs, which executes every user's due Autonomous Agents
# — one unauthenticated call would spend real Anthropic money on every
# account in the system.
CRON_SECRET=your-cron-secret

# Optional. Server-side only. Platform-wide daily circuit breaker (see
# src/lib/ai-circuit-breaker.ts) — once the whole app has made this many
# Claude API calls across every user today, every new AI-calling request
# is rejected with "Service temporarily at capacity" until the date rolls
# over. Defaults to 5000 if unset.
MAX_DAILY_AI_CALLS=5000

# Optional. Server-side only — never expose to the client. The invite code
# for beta testers: entering this exact code (case-sensitive) in the
# "Invite code" field at signup grants full Ultimate-tier access
# (unlimited credits, every capability unlocked) with no Stripe
# subscription — see src/lib/beta.ts and api/signup/route.ts. If unset,
# the field simply never grants anything and signup proceeds as normal
# (Free plan) regardless of what's typed there — it never blocks signup.
BETA_INVITE_CODE=your-beta-invite-code

# Optional. Where the beta feedback banner (shown on Home to beta testers
# 3+ days after signup) links to — a form URL, a mailto: link, etc. Falls
# back to a mailto: placeholder if unset.
BETA_FEEDBACK_URL=mailto:feedback@yourdomain.com

# Optional. Server-side only — never expose to the client. Unsplash API
# access key, used by src/lib/unsplash.ts to fetch real, legal, royalty-
# free stock photos for Website Builder when a generated site needs a
# real photo (a room, food, a product, a team) that no uploaded reference
# image already covers (see src/lib/website-image-resolver.ts). Without
# this key, the app automatically falls back to picsum.photos — also
# real, working photos, just not matched to the specific subject
# requested — so this key is fully optional; nothing breaks without it.
#
# How to get one (free):
#   1. Go to https://unsplash.com/developers and sign in / create a free
#      Unsplash account.
#   2. Click "Your apps" -> "New Application", accept the API guidelines
#      and the "Demo" usage terms (fine for this use case — 50
#      requests/hour on the free Demo tier; apply for Production access
#      later if you need more).
#   3. Give the app a name/description (anything, e.g. "Ionexa AI Website
#      Builder photos").
#   4. Copy the "Access Key" shown on the app's page (NOT the "Secret
#      key") and paste it below.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ---------------------------------------------------------------------
# Autonomous Agents (V3) — fair use.
# ---------------------------------------------------------------------
# All optional. Each caps how many agents an account on that plan may own.
# An agent runs on a schedule forever without further consent, so these
# are the ceiling on recurring, unattended spend per account — which is
# exactly why they are tunable from the hosting dashboard rather than only
# in code (src/lib/agents/agent-limits.ts).
#
# The DEFAULTS are the numbers shown on the pricing page
# (plan.capabilities.maxAiAgents in src/lib/billing/plans.ts) and are used
# whenever the variable is unset, empty, not a whole number, negative, or
# above 1000 — a bad value warns in the server log and is ignored rather
# than clamped, so a typo is visible instead of silently "working".
#
# Overriding one of these does NOT change the number printed on /pricing.
# If you raise a limit for real, change plans.ts too.
AGENT_LIMIT_FREE=0
AGENT_LIMIT_STARTER=2
AGENT_LIMIT_GROWTH=5
AGENT_LIMIT_PROFESSIONAL=15
AGENT_LIMIT_ULTIMATE=50
AGENT_LIMIT_ENTERPRISE=100

# Optional. Server-side only. Maximum agent EXECUTIONS one user can cause
# per rolling hour, from any source (schedule, "Run now", a retry).
# Default 20; accepted range 1-500. This is the second half of fair use:
# the limits above cap how many schedules exist, this caps how hard any
# one account can drive them.
AGENT_MAX_RUNS_PER_HOUR=20

# ---------------------------------------------------------------------
# Website Hosting & Publishing (V3) — fair use.
# ---------------------------------------------------------------------
# All optional. Each caps how many LIVE sites an account on that plan may
# have. Defaults: Free 0, Starter 1, Growth 3, Professional 10,
# Ultimate 30, Enterprise unlimited. Accepts a whole number 0-10000, or
# the literal word "unlimited". A bad value warns in the server log and is
# ignored rather than clamped.
#
# Free is 0 deliberately: hosting anonymous accounts' pages on our own
# domain, indefinitely and for free, is a phishing and spam surface long
# before it is a bandwidth problem.
PUBLISHED_SITE_LIMIT_FREE=0
PUBLISHED_SITE_LIMIT_STARTER=1
PUBLISHED_SITE_LIMIT_GROWTH=3
PUBLISHED_SITE_LIMIT_PROFESSIONAL=10
PUBLISHED_SITE_LIMIT_ULTIMATE=30
PUBLISHED_SITE_LIMIT_ENTERPRISE=unlimited

# Optional. Server-side only. The wildcard domain published sites are
# served from, WITHOUT a protocol — e.g. "ionexa.ai", which makes a site
# whose address is "acme" live at https://acme.ionexa.ai.
#
# Leave this UNSET until a wildcard DNS record (*.your-domain) and a
# wildcard TLS certificate actually exist and point at this deployment.
# Unset, every published site is served from this app's own origin at
# /s/<address>, which works today with no DNS at all. Setting it changes
# only the URL that is displayed and copied — the stored rows hold a bare
# address label, so the switch needs no migration and breaks nothing.
PUBLISHED_SITE_DOMAIN=

# ---------------------------------------------------------------------
# Universal Integrations (V3) — Gmail, Google Drive, Slack.
# ---------------------------------------------------------------------
# The whole feature is OFF until these are set. Nothing else breaks
# without them: /dashboard/integrations renders and says the providers are
# unavailable, and Ionexa Chat behaves exactly as it did before.
#
# ---- 1. THE ENCRYPTION KEY (do this first) --------------------------
# 32 bytes, as 64 hex characters. Generate one with:
#
#     openssl rand -hex 32
#
# Anything that is not exactly 32 bytes is REFUSED rather than stretched
# into a key, so a passphrase here will not silently produce a weak one.
#
# Without this variable the connect endpoint returns 503 and refuses to
# start an OAuth flow — deliberately. Storing somebody's Gmail token in
# plaintext because a variable was missing is not a degraded mode, it is
# the breach.
#
# ROTATING IT invalidates every stored token (they are bound to the key by
# AES-256-GCM). Users are shown "needs reconnecting" and reconnect. Nothing
# is lost except the grants.
INTEGRATION_ENCRYPTION_KEY=

# ---- 2. GOOGLE (covers BOTH Gmail and Google Drive) ------------------
# ONE OAuth client serves both providers. They are separate integrations
# in the product — a user can connect Drive without handing over their
# mail — but they share the client below.
#
# In https://console.cloud.google.com :
#   a. Create (or pick) a project.
#   b. "APIs & Services" -> "Enabled APIs & services" -> "+ ENABLE APIS
#      AND SERVICES". Enable BOTH:
#         - Gmail API
#         - Google Drive API
#   c. "OAuth consent screen":
#         - User type: External
#         - App name, support email, developer contact: yours
#         - Scopes: add exactly these two, and nothing else:
#              https://www.googleapis.com/auth/gmail.readonly
#              https://www.googleapis.com/auth/drive.readonly
#         - Both are "restricted" scopes. While the app is in Testing you
#           can add up to 100 test users and it works immediately. To let
#           the public connect, Google requires verification (a security
#           assessment for restricted scopes) — budget weeks, not days.
#   d. "Credentials" -> "+ CREATE CREDENTIALS" -> "OAuth client ID"
#         - Application type: Web application
#         - Authorised redirect URIs — add BOTH of these, exactly:
#              https://YOUR-DOMAIN/api/integrations/gmail/callback
#              https://YOUR-DOMAIN/api/integrations/google_drive/callback
#           (for local development also add
#              http://localhost:3000/api/integrations/gmail/callback
#              http://localhost:3000/api/integrations/google_drive/callback)
#   e. Copy the client ID and client secret below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- 3. SLACK --------------------------------------------------------
# In https://api.slack.com/apps -> "Create New App" -> "From scratch":
#   a. Name it, pick your workspace.
#   b. "OAuth & Permissions" -> "Redirect URLs" -> Add, exactly:
#          https://YOUR-DOMAIN/api/integrations/slack/callback
#      (and http://localhost:3000/api/integrations/slack/callback locally)
#   c. "OAuth & Permissions" -> "Scopes" -> "Bot Token Scopes". Add
#      exactly these four:
#          channels:read      (list the channels the app is in)
#          channels:history   (read recent messages in those channels)
#          chat:write         (agents post their results)
#          users:read         (resolve who wrote a message)
#      Do NOT add user token scopes — the app only ever uses the BOT token.
#   d. "Basic Information" -> "App Credentials": copy the Client ID and
#      Client Secret below.
#   e. After connecting, INVITE the app to each channel you want it to see:
#      type /invite @YourAppName in that channel. Slack grants no access to
#      a channel the bot was not invited to, and neither does this app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---- 4. FAIR USE (all optional) --------------------------------------
# How many providers an account on each plan may have connected at once.
# Accepts a whole number 0-100 or the word "unlimited".
#
# Free is 0 deliberately: an integration is a standing grant to read
# somebody's mail, and handing that to accounts that were never billed and
# can be created in bulk is how a product becomes the front end for
# somebody else's credential harvesting.
INTEGRATION_LIMIT_FREE=0
INTEGRATION_LIMIT_STARTER=2
INTEGRATION_LIMIT_GROWTH=5
INTEGRATION_LIMIT_PROFESSIONAL=unlimited
INTEGRATION_LIMIT_ULTIMATE=unlimited
INTEGRATION_LIMIT_ENTERPRISE=unlimited

# Reads of connected accounts one user can cause per hour, from any source
# (a chat question, an agent run, a manual sync). Default 60, range 1-1000.
# This is a limit on OUR side of somebody else's API: exceeding Google's
# quota degrades the integration for every user on the same OAuth client,
# so one account must not be able to spend the shared budget.
INTEGRATION_MAX_READS_PER_HOUR=60

# ---- 5. THE COMBINED CEILING (all optional) --------------------------
# Total AI cost an account can generate in a month, worst case, must not
# exceed 25% of what it pays — counting credits AND every free quota
# together, not each subsystem against 25% of its own. See CREDITS.md.
#
#   1/M  +  Σ share_of_each_free_quota   <=  0.25     <=>   margin >= 4x
#
# Per-plan margin. Defaults: FREE 6, every paid plan 5. Range 4-10; a
# value outside it is rejected (not clamped) and the default used.
#
# NOT 4 for the paid plans, and this is the whole point: at M=4 the credit
# subsystem alone consumes the entire 25% and leaves nothing for free
# chat. Lowering any of these to 4 does not breach the ceiling — the free
# quotas clamp themselves to whatever headroom is left, to zero if
# necessary — but it does silently turn free chat off on that plan.
CREDIT_MARGIN_FREE=6
CREDIT_MARGIN_STARTER=5
CREDIT_MARGIN_GROWTH=5
CREDIT_MARGIN_PROFESSIONAL=5
CREDIT_MARGIN_ULTIMATE=5
CREDIT_MARGIN_ENTERPRISE=5

# Free chat messages per month. Defaults 15/43/107/215/430/430. Whatever
# is set here is CLAMPED to the 5% of plan price the quota registry
# allocates, so raising it cannot push past the ceiling — it simply has no
# effect above the clamp. FREE_CHAT_ENABLED=false turns the feature off
# entirely, grandfathered accounts included.
FREE_CHAT_MESSAGES_FREE=15
FREE_CHAT_MESSAGES_STARTER=43
FREE_CHAT_MESSAGES_GROWTH=107
FREE_CHAT_MESSAGES_PROFESSIONAL=215
FREE_CHAT_MESSAGES_ULTIMATE=430
FREE_CHAT_MESSAGES_ENTERPRISE=430

# The floor price of an Enterprise contract, EUR/month. Default 400,
# range 200-1000000.
#
# Enterprise is the one plan with no price in code ("custom"), which used
# to mean its ceiling could not be checked at all: it inherited Ultimate's
# free-chat allowance against a price nothing knew, and any deal under
# ~EUR 150 would have breached 25% on free chat alone. WITHOUT THIS the
# default applies and nothing breaks; what breaks the guarantee is signing
# a deal below whatever this says.
ENTERPRISE_MIN_PRICE_EUR=400
