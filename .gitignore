# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshot artefacts written by the *.prodtest.mjs suites
/files-shots/
/publish-dialog-shots/

# Playwright E2E output — traces and screenshots from a failed run.
e2e-report/
test-results/

# Rendered-audit output: screenshots and JSON reports from
# scripts/prod-*-audit.mjs. Evidence, not source — regenerate with the
# scripts rather than carrying tens of megabytes of PNGs in history.
/prod-audit/
/variety-out/
scripts/tests/.guard-sidecar/

# The mutation suites record originals here before touching a source
# file. A clean run deletes it; its presence means a run was killed.
scripts/tests/.mutation-sidecar.json
