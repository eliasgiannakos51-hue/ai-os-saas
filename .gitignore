# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshot artefacts written by the *.prodtest.mjs suites
/files-shots/
/publish-dialog-shots/
/agent-shots/
/rtl-shots/

# Default --out directories of the two billed measurement runners —
# scripts/agent-tier-compare.mjs and scripts/website-pairs-check.mjs.
# A run writes generated sites and answers there (megabytes of HTML and
# markdown); website-pairs-check re-scores them later with --dry, so they
# are worth keeping on disk and never worth committing. Listed here BEFORE
# the first run rather than after somebody commits one: the sibling
# entries above were all added the same way round.
/pairs-out/
/tiers-out/

# Playwright E2E output — traces and screenshots from a failed run.
e2e-report/
test-results/

# Rendered-audit output: screenshots and JSON reports from
# scripts/prod-*-audit.mjs. Evidence, not source — regenerate with the
# scripts rather than carrying tens of megabytes of PNGs in history.
/prod-audit/
/variety-out/
scripts/tests/.guard-sidecar/

# The mutation suites record originals here before touching a source
# file. A clean run deletes it; its presence means a run was killed.
scripts/tests/.mutation-sidecar.json

# Screenshot output from scripts/design-phase4-verify.mjs and the light-theme audit —
# large binaries, regenerated on demand, never reviewed as source.
prod-audit/
