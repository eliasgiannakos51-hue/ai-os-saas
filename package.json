{
  "name": "ai-os-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/apply-function-limits.mjs && node scripts/check-i18n.js && npm run test:unit && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:mutation && npm run test:integration && npm run test:db && npm run test:prod && npm run test:e2e",
    "check:i18n": "node scripts/check-i18n.js",
    "test:unit": "for f in scripts/tests/*.test.mjs; do echo \"--- $f\"; node \"$f\" || exit 1; done",
    "test:prod": "for f in scripts/tests/*.prodtest.mjs; do echo \"--- $f\"; node \"$f\" || exit 1; done",
    "test:integration": "for f in scripts/tests/*.itest.mjs; do echo \"--- $f\"; node \"$f\" || exit 1; done",
    "test:mutation": "node scripts/tests/run-mutations.mjs",
    "limits": "node scripts/apply-function-limits.mjs",
    "test:db": "node scripts/db/run-dbtests.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.8.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "lucide-react": "^1.27.0",
    "next": "^14.2.35",
    "next-intl": "^4.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
